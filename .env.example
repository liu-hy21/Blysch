DATABASE_URL="mysql://user:password@host:3306/blysch"
JWT_SECRET="replace-with-a-long-random-string"
SITE_URL="https://blysch.cn"
# 每个实际访问入口都要写完整 origin（协议 + 域名 + 端口），POST 接口才会放行
ALLOWED_ORIGINS="https://blysch.cn,https://www.blysch.cn,http://blysch.cn,http://localhost:3000,http://192.168.1.86:3000,http://192.168.1.192:3009"
# 可选：强制 Session Cookie 是否 Secure（默认按实际请求 http/https 判断）
# COOKIE_SECURE=false
UPLOAD_DIR="./uploads"
