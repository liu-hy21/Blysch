DATABASE_URL="mysql://user:password@host:3306/blysch"
JWT_SECRET="replace-with-a-long-random-string"
SITE_URL="http://localhost:3000"
# 局域网访问时把实际访问地址（含端口）写进 ALLOWED_ORIGINS，否则登录等 POST 会 403
ALLOWED_ORIGINS="http://localhost:3000,http://192.168.1.192:3009"
# 可选：强制 Session Cookie 是否 Secure（默认按实际请求 http/https 判断）
# COOKIE_SECURE=false
UPLOAD_DIR="./uploads"
